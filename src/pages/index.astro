---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import NewsList from '../components/NewsList.astro';
import { selectedPublications } from '../data/publications';

---

<BaseLayout>
  <Hero />
  <section id="news" class="section news-section" aria-labelledby="news-title">
    <div class="section-heading">
      <h2 id="news-title">News</h2>
    </div>
    <NewsList limit={5} />
    <details class="older-news">
      <summary class="section-more">Earlier updates <span aria-hidden="true">⌄</span></summary>
      <NewsList offset={5} />
    </details>
  </section>
  <ResearchAreas />

  <section class="section selected-section" aria-labelledby="selected-title">
    <div class="section-heading">
      <h2 id="selected-title">Selected papers</h2>
    </div>
    <ol class="selected-list">
      {selectedPublications.map((publication) => (
        <li class="selected-item">
          <span class="selected-venue">{publication.venue}</span>
          <div class="selected-copy">
            <h3><a href={'/publication/' + publication.slug + '/'}>{publication.title}</a></h3>
            <p class="selected-authors">{publication.authors.map((author, index) => <><span>{author === 'Weifei Jin' ? <strong>{author}</strong> : author}</span>{index < publication.authors.length - 1 ? ', ' : ''}</>)}</p>
          </div>
          {publication.paper && <a class="selected-paper" href={publication.paper} target="_blank" rel="noopener noreferrer" aria-label={'Read paper: ' + publication.title}>Paper <span aria-hidden="true">↗</span></a>}
        </li>
      ))}
    </ol>
    <a class="section-more" href="/publications/">View all publications <span aria-hidden="true">→</span></a>
  </section>

  <section class="section recognition-section" aria-label="Awards, service, and mentoring">
    <div class="recognition-grid">
      <div class="recognition-block">
        <h2>Awards</h2>
        <ul class="plain-list"><li><span>2026</span> Pratt Gardner Fellowship, Duke University</li><li><span>2025</span> Xiaomi Grand Prize Scholarship</li><li><span>2024</span> Second Prize, 9th National Cryptography Technology Competition</li></ul>
      </div>
      <div class="recognition-block">
        <h2>Service</h2>
        <p>Reviewer for NeurIPS 2026, ICASSP 2026/2027, ICME 2025/2026, and IEEE TDSC.</p>
      </div>
      <div class="recognition-block">
        <h2>Mentoring</h2>
        <p>I have mentored junior students working on trustworthy audio-language models.</p>
      </div>
    </div>
  </section>
</BaseLayout>
