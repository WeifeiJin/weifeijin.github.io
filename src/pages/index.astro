---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import NewsList from '../components/NewsList.astro';
import { selectedPublications } from '../data/publications';

---

<BaseLayout>
  <Hero />
  <ResearchAreas />

  <section class="section selected-section" aria-labelledby="selected-title">
    <div class="section-heading">
      <h2 id="selected-title">Selected work</h2>
    </div>
    <ol class="selected-list">
      {selectedPublications.map((publication) => (
        <li class="selected-item">
          <span class="selected-venue">{publication.venue}</span>
          <div class="selected-copy">
            <p class="selected-topic">{publication.topic}</p>
            <h3><a href={'/publication/' + publication.slug + '/'}>{publication.title}</a></h3>
            <p class="selected-authors">{publication.authors.join(', ')}</p>
          </div>
          <a class="selected-paper" href={publication.paper} target="_blank" rel="noopener noreferrer" aria-label={'Read paper: ' + publication.title}>Paper <span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ol>
    <a class="section-more" href="/publications/">View all publications <span aria-hidden="true">→</span></a>
  </section>

  <section id="news" class="section updates-section" aria-labelledby="news-title">
    <div class="section-heading">
      <h2 id="news-title">Updates &amp; recognition</h2>
    </div>
    <div class="updates-grid">
      <div>
        <h3 class="updates-label">News</h3>
        <NewsList limit={5} />
        <details class="older-news">
          <summary class="section-more">Earlier updates <span aria-hidden="true">⌄</span></summary>
          <NewsList offset={5} />
        </details>
      </div>
      <aside class="recognition" aria-label="Awards and service">
        <div class="about-side-section">
          <h3>Awards</h3>
          <ul class="plain-list"><li><span>2025</span> Xiaomi Grand Prize Scholarship</li><li><span>2024</span> Second Prize, 9th National Cryptography Technology Competition</li></ul>
        </div>
        <div class="about-side-section">
          <h3>Service &amp; mentoring</h3>
          <p>Reviewer for TDSC, ICASSP 2026, and ICME 2026/2025. I have also mentored junior students working on trustworthy audio-language models.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
