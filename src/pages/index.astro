---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import PublicationCard from '../components/PublicationCard.astro';
import NewsList from '../components/NewsList.astro';
import { selectedPublications } from '../data/publications';

---

<BaseLayout>
  <Hero />
  <ResearchAreas />

  <section class="section selected-section" aria-labelledby="selected-title">
    <div class="section-heading">
      <div><p class="eyebrow">SELECTED WORK</p><h2 id="selected-title">Research in focus.</h2></div>
      <p class="section-description">Recent work on audio-language safety, speech privacy, and adversarial robustness.</p>
    </div>
    <div class="selected-grid">
      {selectedPublications.map((publication) => <PublicationCard publication={publication} />)}
    </div>
    <a class="section-more" href="/publications/">View all publications <span aria-hidden="true">→</span></a>
  </section>

  <section class="section news-section" aria-labelledby="news-title">
    <div class="section-heading">
      <div><p class="eyebrow">LATEST UPDATES</p><h2 id="news-title">News.</h2></div>
      <p class="section-description">A few recent milestones and activities.</p>
    </div>
    <NewsList limit={5} />
    <a class="section-more" href="/about/#news">View all news <span aria-hidden="true">→</span></a>
  </section>

  <section class="section home-about" aria-labelledby="about-title">
    <div><p class="eyebrow">BEYOND THE PAPERS</p><h2 id="about-title">Research is collaborative.</h2></div>
    <div class="home-about-copy">
      <p>My work spans multimodal robustness and the safety of language models and agents. I have also worked with the ByteDance SecurityFlow Team and collaborate with researchers across institutions.</p>
      <a class="section-more" href="/about/">More about me <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
