---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import NewsList from '../components/NewsList.astro';
import ResearchExperience from '../components/ResearchExperience.astro';
import { selectedPublications } from '../data/publications';
import { mentoringCollaborations } from '../data/mentoring';

---

<BaseLayout>
  <Hero />
  <section id="news" class="section news-section" aria-labelledby="news-title">
    <div class="section-heading">
      <h2 id="news-title">News</h2>
    </div>
    <NewsList limit={5} />
    <details class="older-news">
      <summary class="section-more">Earlier updates <span aria-hidden="true">⌄</span></summary>
      <NewsList offset={5} />
    </details>
  </section>
  <ResearchAreas />

  <section id="selected" class="section selected-section" aria-labelledby="selected-title">
    <div class="section-heading">
      <h2 id="selected-title">Selected papers</h2>
    </div>
    <ol class="selected-list">
      {selectedPublications.map((publication) => (
        <li class="selected-item">
          <div class="selected-figure">
            <img src={publication.figure} alt={publication.figureAlt} loading="lazy" decoding="async" />
          </div>
          <div class="selected-copy">
            <p class="selected-venue">{publication.venue}</p>
            <h3><a href={'/publication/' + publication.slug + '/'}>{publication.title}</a></h3>
            <p class="selected-authors">{publication.authors.map((author, index) => <><span>{author === 'Weifei Jin' ? <strong>{author}</strong> : author}</span>{index < publication.authors.length - 1 ? ', ' : ''}</>)}</p>
            {publication.paper && <a class="selected-paper" href={publication.paper} target="_blank" rel="noopener noreferrer" aria-label={'Read paper: ' + publication.title}>Paper <span aria-hidden="true">↗</span></a>}
          </div>
        </li>
      ))}
    </ol>
    <a class="section-more" href="/publications/">View all publications <span aria-hidden="true">→</span></a>
  </section>

  <ResearchExperience />

  <section id="awards" class="section recognition-section" aria-labelledby="awards-title">
    <div class="section-heading"><h2 id="awards-title">Awards</h2></div>
    <ul class="plain-list awards-list">
      <li><span>2026</span> Top Reviewer, NeurIPS</li>
      <li><span>2026</span> Pratt Gardner Fellowship, Duke University</li>
      <li><span>2025</span> Xiaomi Grand Prize Scholarship (Top 0.01%)</li>
      <li><span>2024</span> Second Prize, 9th National Cryptography Technology Competition</li>
    </ul>
  </section>

  <section id="services" class="section recognition-section" aria-labelledby="services-title">
    <div class="section-heading"><h2 id="services-title">Services</h2></div>
    <p class="service-description">Reviewer for NeurIPS 2026, ICASSP 2026/2027, ICME 2025/2026, and IEEE TDSC.</p>
  </section>

  <section id="mentoring" class="section recognition-section mentoring-section" aria-labelledby="mentoring-title">
    <div class="section-heading"><h2 id="mentoring-title">Mentoring</h2></div>
    <p class="mentoring-intro">I'm fortunate to work with these people:</p>
    <ol class="mentoring-rows">
      {mentoringCollaborations.map((collaboration) => (
        <li class="mentoring-row">
          <div class="mentoring-people">
            {collaboration.people.map((person) => person.homepage
              ? <a class="mentoring-person mentoring-person-link" href={person.homepage} target="_blank" rel="noopener noreferrer" aria-label={'Visit ' + person.name + '’s homepage'}>{person.name}<span aria-hidden="true">↗</span></a>
              : <span class="mentoring-person">{person.name}</span>
            )}
          </div>
          <div class="mentoring-work">
            <p>{collaboration.outcome}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
