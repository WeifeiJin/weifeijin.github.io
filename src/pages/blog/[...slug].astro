---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogViews from '../../components/BlogViews.astro';
import BlogComments from '../../components/BlogComments.astro';
import BlogLike from '../../components/BlogLike.astro';
import { blogLikes, blogViewPaths } from '../../data/blog-interactions';
import { blogDate, blogUrl, groupBlogPosts, readingStats, type BlogEntry } from '../../data/blog';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = groupBlogPosts(await getCollection('blog')).flat();
  return posts.map((post) => ({
    params: { slug: post.data.slug + (post.data.language === 'en' ? '/en' : '') },
    props: { post, translations: posts.filter((translation) => translation.data.slug === post.data.slug) },
  }));
}

interface Props { post: BlogEntry; translations: BlogEntry[]; }
const { post, translations } = Astro.props;
const { Content, headings } = await render(post);
const chinese = post.data.language === 'zh';
const lang = chinese ? 'zh-CN' : 'en';
const stats = readingStats(post);
const likesApi = import.meta.env.PUBLIC_BLOG_LIKES_API ?? blogLikes.apiUrl;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const languageAlternates = translations.map((translation) => ({
  lang: translation.data.language === 'zh' ? 'zh-CN' : 'en', href: blogUrl(translation),
}));
const defaultTranslation = translations.find((translation) => translation.data.language === 'zh') ?? translations[0];
languageAlternates.push({ lang: 'x-default', href: blogUrl(defaultTranslation) });
---

<BaseLayout title={`${post.data.title} — Weifei Jin`} description={post.data.description} lang={lang} languageAlternates={languageAlternates} ogType="article">
  <article class="blog-article">
    <header class="blog-article-header">
      <a class="blog-back" href="/blog/">← {chinese ? '所有文章' : 'All posts'}</a>
      <h1>{post.data.title}</h1>
      <div class="blog-article-meta">
        <span>{chinese ? '发布于 ' : 'Published '}<time datetime={post.data.publishedAt}>{blogDate(post.data.publishedAt, post.data.language)}</time></span>
        {post.data.talkDate && <span>{chinese ? '分享于 ' : 'Talk given '}<time datetime={post.data.talkDate}>{blogDate(post.data.talkDate, post.data.language)}</time></span>}
        <BlogViews canonicalUrl={new URL(blogViewPaths[post.data.slug] ?? `/blog/${post.data.slug}/`, Astro.site!).href} language={post.data.language} />
      </div>
      <p class="blog-reading-stats">{stats.label}</p>
      <nav class="blog-language-switch" aria-label={chinese ? '文章语言' : 'Article language'}>
        {translations.sort((a, b) => a.data.language === b.data.language ? 0 : a.data.language === 'zh' ? -1 : 1).map((translation) => (
          <a href={blogUrl(translation)} lang={translation.data.language === 'zh' ? 'zh-CN' : 'en'} hreflang={translation.data.language === 'zh' ? 'zh-CN' : 'en'} aria-current={translation.data.language === post.data.language ? 'page' : undefined}>
            {translation.data.language === 'zh' ? '中文' : 'English'}
          </a>
        ))}
      </nav>
    </header>

    <div class="blog-article-layout">
      <div class="blog-article-main">
        {post.data.introduction && <aside class="blog-introduction"><p>{post.data.introduction}</p></aside>}
        {toc.length > 0 && <details class="blog-mobile-toc">
          <summary>{chinese ? '目录' : 'Contents'}</summary>
          <nav aria-label={chinese ? '文章目录' : 'Table of contents'}><ol>{toc.map((heading) => <li class:list={{ 'toc-subheading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
        </details>}
        <div class="blog-prose"><Content /></div>
        <BlogComments slug={post.data.slug} language={post.data.language} />
        <a class="blog-back blog-end-link" href="/blog/">← {chinese ? '返回 Blog' : 'Back to Blog'}</a>
      </div>
      {toc.length > 0 && <aside class="blog-desktop-toc">
        <nav aria-label={chinese ? '文章目录' : 'Table of contents'}>
          <h2>{chinese ? '目录' : 'Contents'}</h2>
          <ol>{toc.map((heading) => <li class:list={{ 'toc-subheading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </nav>
      </aside>}
    </div>
  </article>
  {likesApi && <BlogLike slug={post.data.slug} language={post.data.language} apiUrl={likesApi} />}
</BaseLayout>

<script>
  function fitBlogContents() {
    const toc = document.querySelector<HTMLElement>('.blog-desktop-toc');
    if (!toc || toc.dataset.viewportFitted) return;
    toc.dataset.viewportFitted = 'true';
    let queued = false;
    const fit = () => {
      queued = false;
      // Reserve space below the visible directory for the fixed heart button.
      toc.style.setProperty('--toc-viewport-space', `${Math.max(0, window.innerHeight - toc.getBoundingClientRect().top)}px`);
    };
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(fit);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    void document.fonts.ready.then(schedule);
    fit();
  }
  fitBlogContents();
  document.addEventListener('astro:page-load', fitBlogContents);
</script>
