---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationListItem from '../components/PublicationListItem.astro';
import { publications } from '../data/publications';
const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
---

<BaseLayout title="Publications — Weifei Jin" description="Publications by Weifei Jin in AI security, multimodal robustness, speech privacy, and trustworthy AI.">
  <header class="page-intro">
    <p class="eyebrow">RESEARCH OUTPUT</p>
    <h1>Publications<span class="heading-period">.</span></h1>
    <p>Selected peer-reviewed research on secure and trustworthy AI systems.</p>
  </header>
  <div class="publication-years">
    {years.map((year) => (
      <section class="publication-year" aria-labelledby={'year-' + year}>
        <h2 id={'year-' + year}>{year}</h2>
        <div>{publications.filter((publication) => publication.year === year).map((publication) => <PublicationListItem publication={publication} />)}</div>
      </section>
    ))}
  </div>
</BaseLayout>
