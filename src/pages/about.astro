---
const destination = '/#about';
const canonical = new URL(destination, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={'0; url=' + destination} />
    <link rel="canonical" href={canonical} />
    <title>About — Weifei Jin</title>
  </head>
  <body>
    <p>The About section is now on the <a href={destination}>homepage</a>.</p>
  </body>
</html>
