---
import { news } from '../data/news';
interface Props { limit?: number; offset?: number; }
const { limit, offset = 0 } = Astro.props;
const items = news.slice(offset, typeof limit === 'number' ? offset + limit : undefined);
---

<ol class="news-list">
  {items.map((item) => {
    const highlightAt = item.highlight ? item.text.indexOf(item.highlight) : -1;
    return (
      <li>
        <time datetime={item.dateTime}>{item.date}</time>
        <span class="news-icon" aria-hidden="true">
          {item.kind === 'career' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" /><path d="M14 3v5h4M8 13h8M8 17h6" /></svg>
          )}
        </span>
        <p>{highlightAt >= 0 && item.highlight ? <>{item.text.slice(0, highlightAt)}<em>{item.highlight}</em>{item.text.slice(highlightAt + item.highlight.length)}</> : item.text}</p>
      </li>
    );
  })}
</ol>
