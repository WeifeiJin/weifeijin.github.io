---
import { news } from '../data/news';
interface Props { limit?: number; offset?: number; }
const { limit, offset = 0 } = Astro.props;
const items = news.slice(offset, typeof limit === 'number' ? offset + limit : undefined);
---

<ol class="news-list">
  {items.map((item) => <li><time>{item.date}</time><p>{item.text}</p></li>)}
</ol>
