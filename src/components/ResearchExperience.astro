---
import { researchExperience } from '../data/experience';
---

<section id="experience" class="section experience-section" aria-labelledby="experience-title">
  <div class="section-heading">
    <h2 id="experience-title">Experiences</h2>
  </div>
  <ol class="experience-list">
    {researchExperience.map((experience) => (
      <li class="experience-item">
        <span class="experience-logo" aria-hidden="true">
          <img src={experience.logo} alt="" loading="lazy" decoding="async" />
        </span>
        <div class="experience-copy">
          <div class="experience-topline">
            <h3>{experience.institution}{experience.unit && <span class="experience-unit"> · {experience.unit}</span>}{experience.remote && <span class="experience-remote"> (Remote)</span>}</h3>
            <span class="experience-period">{experience.period}</span>
          </div>
          <p class="experience-role">{experience.role}</p>
          <p class="experience-details">{experience.details.map((part) => typeof part === 'string' ? part : <a href={part.url} target="_blank" rel="noopener noreferrer">{part.name}</a>)}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
