---
import { researchAreas } from '../data/research';
import { publications } from '../data/publications';
const paperBySlug = new Map(publications.map((publication) => [publication.slug, publication]));
---

<section id="research" class="section research-section" aria-labelledby="research-title">
  <div class="section-heading">
    <h2 id="research-title">Research interests</h2>
  </div>
  <div class="research-list">
    {researchAreas.map((area) => (
      <article class="research-area">
        <div class="research-area-main">
          <span class="area-number">{area.number}</span>
          <h3>{area.name}</h3>
          <p class="area-subtitle">{area.subtitle}</p>
          <p class="area-description">{area.description}</p>
        </div>
        {area.paperSlugs.length > 0 || (area.preprints?.length ?? 0) > 0 ? (
          <div class="research-related">
            <h4>Related papers</h4>
            <ul>
              {area.paperSlugs.map((slug) => {
                const paper = paperBySlug.get(slug);
                if (!paper) throw new Error(`Unknown research paper: ${slug}`);
                return <li><a href={'/publication/' + paper.slug + '/'}>{paper.title}</a><span>{paper.venue}</span></li>;
              })}
              {area.preprints?.map((paper) => <li><a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a><span>arXiv preprint {paper.year}</span></li>)}
            </ul>
          </div>
        ) : (
          <div class="research-related research-current">
            <h4>Current directions</h4>
            <ul>{area.currentTopics?.map((topic) => <li>{topic}</li>)}</ul>
          </div>
        )}
      </article>
    ))}
  </div>
</section>
