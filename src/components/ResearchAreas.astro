---
import { researchAreas } from '../data/research';
---

<section id="research" class="section research-section" aria-labelledby="research-title">
  <div class="section-heading">
    <div><p class="eyebrow">THE RESEARCH THREAD</p><h2 id="research-title">Three layers of AI security</h2></div>
    <p class="section-description">From the signals AI perceives to the decisions it makes and the knowledge it retains.</p>
  </div>
  <div class="research-grid">
    {researchAreas.map((area) => (
      <article class="research-area">
        <span class="area-number">{area.number} <span aria-hidden="true">→</span></span>
        <h3>{area.name}</h3>
        <p class="area-subtitle">{area.subtitle}</p>
        <p class="area-description">{area.description}</p>
      </article>
    ))}
  </div>
</section>
