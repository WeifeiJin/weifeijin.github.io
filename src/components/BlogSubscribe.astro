---
interface Props { language?: 'zh' | 'en' | 'both'; }
const { language = 'both' } = Astro.props;
const showChinese = language !== 'en';
const showEnglish = language !== 'zh';
const heading = language === 'both' ? '订阅更新 · Subscribe' : language === 'zh' ? '订阅更新' : 'Subscribe';
---

<section class="blog-subscribe" data-blog-subscribe data-subscribe-language={language} aria-labelledby="blog-subscribe-heading">
  <h2 id="blog-subscribe-heading">{heading}</h2>
  <div class="blog-subscribe-note">
    {showChinese && <p lang="zh-CN">订阅后通过邮件接收新文章，可随时退订。</p>}
    {showEnglish && <p lang="en">Get new posts by email. Unsubscribe anytime.</p>}
  </div>
  <div class="blog-subscribe-form">
    <script
      is:inline
      async
      src="https://eomail5.com/form/10de4992-c1d0-11f1-b2f4-6328ab11288d.js"
      data-form="10de4992-c1d0-11f1-b2f4-6328ab11288d"
      onerror="this.closest('[data-blog-subscribe]')?.querySelector('[data-subscribe-error]')?.removeAttribute('hidden');"
    ></script>
    <noscript>
      {showChinese && <p lang="zh-CN">请启用 JavaScript 以加载订阅表单。</p>}
      {showEnglish && <p lang="en">Enable JavaScript to load the subscription form.</p>}
    </noscript>
  </div>
  <div class="blog-subscribe-error" data-subscribe-error role="status" hidden>
    {showChinese && <p lang="zh-CN">订阅表单暂时无法加载，请稍后刷新页面重试。</p>}
    {showEnglish && <p lang="en">The subscription form could not load. Please refresh the page and try again later.</p>}
  </div>
</section>

<script>
  for (const section of document.querySelectorAll('[data-blog-subscribe]')) {
    const language = section.getAttribute('data-subscribe-language');
    if (language !== 'zh' && language !== 'en') continue;

    const container = section.querySelector('.blog-subscribe-form');
    if (!container) continue;
    const label = language === 'zh' ? '订阅' : 'Subscribe';
    const confirmation = language === 'zh'
      ? '请查收邮件并点击链接确认订阅。'
      : 'Please check your inbox to confirm your subscription.';
    const providerConfirmation = '请查收邮件并点击链接确认订阅。 / Please check your inbox to confirm your subscription.';

    const localizeFormText = () => {
      const submit = container.querySelector<HTMLInputElement>(
        '[data-form="10de4992-c1d0-11f1-b2f4-6328ab11288d"] form.emailoctopus-form input[type="submit"]',
      );
      if (submit && submit.value !== label) submit.value = label;

      const success = container.querySelector<HTMLElement>(
        '[data-form="10de4992-c1d0-11f1-b2f4-6328ab11288d"] .emailoctopus-success-message',
      );
      if (success?.textContent?.trim() === providerConfirmation) {
        success.textContent = confirmation;
        success.lang = language === 'zh' ? 'zh-CN' : 'en';
      }
    };

    // Localize only the submit label and the provider's populated confirmation
    // text. The embed still owns validation, submission and success/error state.
    const observer = new MutationObserver(localizeFormText);
    observer.observe(container, { childList: true, characterData: true, subtree: true });
    localizeFormText();
  }
</script>

<style>
  .blog-subscribe { max-width: 740px; margin-block: 32px; padding: 22px 24px; border: 1px solid var(--line); border-radius: 9px; background: var(--paper); color: var(--ink); }
  .blog-subscribe h2 { margin: 0 0 10px; font-size: 18px; font-weight: 650; line-height: 1.5; }
  .blog-subscribe-note { margin-bottom: 18px; color: var(--muted); }
  .blog-subscribe-note p, .blog-subscribe-error p { margin: 0; font-size: 13px; line-height: 1.8; }
  .blog-subscribe-note p + p, .blog-subscribe-error p + p { margin-top: 4px; }
  .blog-subscribe-form { min-width: 0; padding: 14px 16px; border: 1px solid var(--line); border-radius: 6px; background: var(--related-bg); color: var(--ink); color-scheme: inherit; }
  /* Map the embedded form's colors to the live site theme. Keep its markup,
     submission state and provider branding intact. */
  .blog-subscribe-form :global([data-form="10de4992-c1d0-11f1-b2f4-6328ab11288d"]) {
    --text-colour: var(--ink);
    color: var(--ink);
    font-family: inherit;
    color-scheme: inherit;
  }
  .blog-subscribe-form :global(.emailoctopus-form) {
    --field-colour: var(--paper);
    --field-border-colour: var(--line);
    --label-colour: var(--ink);
    --button-colour: var(--blue);
    --button-text-colour: var(--button-text);
    --eo-form-font-color: var(--ink);
    --eo-form-placeholder: var(--muted);
    --eo-form-input-background: var(--paper);
    --eo-form-border-color: var(--line);
    color: var(--ink);
  }
  .blog-subscribe-form :global(.emailoctopus-form label) { color: var(--ink); font-family: inherit; }
  .blog-subscribe-form :global(.emailoctopus-form input[type="email"]) {
    background-color: var(--paper);
    border-color: var(--line);
    color: var(--ink);
    caret-color: var(--ink);
    font-family: inherit;
  }
  .blog-subscribe-form :global(.emailoctopus-form input[type="email"]::placeholder) { color: var(--muted); opacity: 1; }
  .blog-subscribe-form :global(.emailoctopus-form input[type="email"]:focus) {
    background-color: var(--paper);
    border-color: var(--blue);
    color: var(--ink);
    box-shadow: 0 0 0 3px var(--blue-soft);
  }
  .blog-subscribe-form :global(.emailoctopus-form input[type="submit"]) {
    background-color: var(--blue);
    border-color: var(--blue);
    color: var(--button-text);
    font-family: inherit;
  }
  .blog-subscribe-form :global(.emailoctopus-form input[type="submit"]:hover:not(:disabled)),
  .blog-subscribe-form :global(.emailoctopus-form input[type="submit"]:active:not(:disabled)) {
    background-color: var(--blue-hover);
    border-color: var(--blue-hover);
    color: var(--button-text);
  }
  .blog-subscribe-form :global(.emailoctopus-form input[type="submit"]:focus) {
    color: var(--button-text);
    box-shadow: 0 0 0 3px var(--blue-soft);
  }
  .blog-subscribe-form :global(.emailoctopus-form input:focus-visible) { outline: 2px solid var(--blue); outline-offset: 2px; }
  .blog-subscribe-form :global(.emailoctopus-form input[type="submit"]:disabled) {
    background-color: var(--blue);
    border-color: var(--blue);
    color: var(--button-text);
    opacity: .6;
    cursor: wait;
  }
  .blog-subscribe-form :global(.emailoctopus-success-message),
  .blog-subscribe-form :global(.emailoctopus-error-message) { font-size: 14px; line-height: 1.7; }
  /* The provider marks these message colors important, so override only those
     color declarations inside this subscription section. */
  .blog-subscribe-form :global(.emailoctopus-success-message) { color: var(--ink) !important; }
  .blog-subscribe-form :global(.emailoctopus-error-message) { color: var(--news-accent) !important; }
  .blog-subscribe-form :global(.mastfoot) { font-family: inherit; }
  .blog-subscribe-form :global(.mastfoot p) { background: transparent; border-color: transparent; color: var(--muted); }
  .blog-subscribe-form :global(.mastfoot a) { color: var(--blue); }
  .blog-subscribe-form :global(.mastfoot a:hover) { color: var(--blue-hover); }
  .blog-subscribe-form :global(.mastfoot a:focus-visible) { outline: 2px solid var(--blue); outline-offset: 2px; }
  .blog-subscribe-form :global(noscript p) { margin: 0; font-size: 13px; line-height: 1.8; }
  .blog-subscribe-error { margin-top: 12px; color: var(--news-accent); }
  @media (max-width: 480px) {
    .blog-subscribe { padding: 18px; }
    .blog-subscribe-form { padding: 12px; }
  }
</style>
