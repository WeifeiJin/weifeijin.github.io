---
import type { Publication } from '../data/publications';
interface Props { publication: Publication; }
const { publication } = Astro.props;
---

<article class="publication-list-item">
  <div class="publication-list-main">
    <h3><a href={'/publication/' + publication.slug + '/'}>{publication.title}</a></h3>
    <p class="author-list">{publication.authors.map((author, index) => <><span>{author === 'Weifei Jin' ? <strong>{author}</strong> : author}</span>{index < publication.authors.length - 1 ? ', ' : ''}</>)}</p>
    <p class="publication-venue">{publication.venue}</p>
  </div>
  {publication.paper && <a class="publication-paper" href={publication.paper} target="_blank" rel="noopener noreferrer" aria-label={'Read paper: ' + publication.title}>Paper <span aria-hidden="true">↗</span></a>}
</article>
